# ══════════════════════════════════════════════════════════
# PPT2Video 环境变量配置
# 复制此文件为 .env 并填写实际值
# ══════════════════════════════════════════════════════════

# ── JWT 密钥 ───────────────────────────────────────────
# 生产环境务必设置强随机字符串！
JWT_SECRET=your_secret_key_here_change_me
JWT_EXPIRE_HOURS=24

# ── SiliconFlow AI 配置 ────────────────────────────────
# API Key，多个用逗号分隔可自动轮询
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 文本生成模型（解说词生成）
TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct

# 视觉大模型（从图片提取文字）
VLM_MODEL=Qwen/Qwen2-VL-7B-Instruct

# TTS 语音合成模型
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B

# TTS 模式: api（SiliconFlow）/ chattts（本地 ChatTTS）/ local（本地 CosyVoice）
TTS_MODE=api

# ── 外部工具路径（留空自动检测） ───────────────────────
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# POPPLER_PATH=C:\poppler\Library\bin
# FFMPEG_PATH=

# ── VLM 过滤关键词（逗号分隔，过滤 PPT 中的无关文字） ──
VLM_FILTER_PATTERNS=

# VLM 并发数（同时调用的 VLM API 数量，默认 1，免费版 API 建议保持 1）
VLM_CONCURRENCY=1

# 异步切换阈值：超过此页数自动要求使用异步任务（默认 10）
ASYNC_THRESHOLD_SLIDES=10

# ── 服务配置 ───────────────────────────────────────────
HOST=0.0.0.0
PORT=9002
# 生产环境改为实际域名 https://your-domain.com
FRONTEND_URL=http://localhost:5173
# 生产环境 HTTPS 时改为 true
COOKIE_SECURE=false

# ── Gunicorn 配置（生产环境） ───────────────────────────
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info

# ── 存储路径 ───────────────────────────────────────────
UPLOAD_DIR=files
VIDEO_OUTPUT_DIR=output_videos
